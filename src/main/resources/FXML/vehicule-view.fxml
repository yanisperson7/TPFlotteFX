<AnchorPane prefHeight="700.0" prefWidth="931.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.vannes.FXController.FlotteController">
   <children>
       <ChoiceBox fx:id="choixTri" layoutX="261.0" layoutY="70.0">
           <items>
               <FXCollections fx:factory="observableArrayList">
                   <String fx:value="Marque, puis modèle" />
                   <String fx:value="Date de mise en circulation" />
                   <String fx:value="Kilométrage décroissant" />
               </FXCollections>
           </items>
       </ChoiceBox>
      <VBox layoutX="45.0" layoutY="70.0" prefHeight="248.0" prefWidth="206.0">
         <children>
            <Text fx:id="titreFormulaire" strokeType="OUTSIDE" strokeWidth="0.0" text="Creer un  véhicule" wrappingWidth="177.33673095703125">
               <font>
                  <Font size="14.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin>
            </Text>
            <TextField fx:id="immat" prefHeight="26.0" prefWidth="151.0" promptText="Immatriculation">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </TextField>
            <TextField fx:id="marque" promptText="Marque">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </TextField>
            <TextField fx:id="modele" promptText="Modèle">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </TextField>
            <DatePicker fx:id="dateMiseCirculation" prefHeight="26.0" prefWidth="208.0" promptText="01/01/2000">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </DatePicker>
             <Label fx:id="erreurDate" style="-fx-text-fill: red;" />
            <TextField fx:id="km" promptText="Km">
               <VBox.margin>
                  <Insets top="5.0" />
               </VBox.margin>
            </TextField>
             <Label fx:id="erreurKm" style="-fx-text-fill: red;" />
            <Button fx:id="valider" mnemonicParsing="false" onAction="#onAjouterVehicule" text="Valider">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
             <Label fx:id="message" wrapText="true" />
