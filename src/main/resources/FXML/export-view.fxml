<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="950.0" style="-fx-background-color: #f8f9fa; -fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="fr.vannes.FXController.ExportController">

    <!-- BARRE DE NAVIGATION -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #ffffff; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Button mnemonicParsing="false" onAction="#onAccueilButtonClick" style="-fx-background-color: #e9ecef; -fx-text-fill: #495057; -fx-font-weight: bold; -fx-background-radius: 6;" text="Accueil" />
                <Button mnemonicParsing="false" onAction="#onVehiculeButtonClick" style="-fx-background-color: #e9ecef; -fx-text-fill: #495057; -fx-font-weight: bold; -fx-background-radius: 6;" text="Véhicules" />
                <Button mnemonicParsing="false" onAction="#onReservationButtonClick" style="-fx-background-color: #e9ecef; -fx-text-fill: #495057; -fx-font-weight: bold; -fx-background-radius: 6;" text="Réservations" />
            </children>
        </HBox>
    </top>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <HBox fx:id="contenuPrincipal" spacing="25.0">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <children>

                <!-- SECTION GAUCHE : ACTIONS -->
                <VBox spacing="15.0" maxWidth="350.0" minWidth="280.0" HBox.hgrow="NEVER">
                    <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #212529;" text="Actions" />

                        <VBox spacing="10.0" style="-fx-background-color: #ffffff; -fx-padding: 15; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 5, 0, 0, 1);">
                            <children>
                                <Button fx:id="btnGenerer" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onGenererButtonClick" style="-fx-background-color: #0d6efd; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10;" text="Générer PDF et envoyer le mail" />
                                <Button fx:id="btnExporter" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onExporterButtonClick" style="-fx-background-color: #198754; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10;" text="Exporter salariés et réservations" />
                                <Button fx:id="btnLireFichier" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onLireFichierButtonClick" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10;" text="Ouvrir dans le navigateur" />
                                <Button fx:id="btnSupprimer" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onSupprimerButtonClick" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 10;" text="Supprimer" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- SECTION DROITE : TABLEAU (PREND TOUT L'ESPACE RESTANT) -->
                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #212529;" text="Liste des fichiers" />
                        <TableView fx:id="listeFichiers" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dee2e6;">
                            <columns>
                                <TableColumn fx:id="nom" prefWidth="250.0" text="Nom" />
                                <TableColumn fx:id="taille" prefWidth="100.0" text="Taille" />
                                <TableColumn fx:id="etat" prefWidth="100.0" text="État" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

            </children>
        </HBox>
    </center>
</BorderPane>
